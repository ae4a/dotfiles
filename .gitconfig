[include]
  path = ~/.config/git/creds.gitconfig

[gpg]
  program = /opt/homebrew/bin/gpg

[commit]
  gpgsign = true

[core]
  pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true
  dark = true
  syntax-theme = kanagawa
  commit-decoration-style = bold yellow box ul
  file-style = bold white
  file-decoration-style = bold white ul
  hunk-header-style = bold syntax
  hunk-header-decoration-style = none
  line-numbers = true
  max-line-distance = 1.0
  wrap-max-lines = 0

[merge]
  conflictStyle = zdiff3
